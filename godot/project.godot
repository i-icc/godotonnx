; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="godotonnx demo"
config/description="コハク (AIVMX) をローカル ONNX 推論で発話させる Godot 4 デモ"
run/main_scene="res://scenes/Demo.tscn"
config/features=PackedStringArray("4.7", "C#")
config/icon="res://icon.svg"

[dotnet]

project/assembly_name="Demo"

[display]

window/size/viewport_width=980
window/size/viewport_height=720
window/stretch/mode="disabled"
